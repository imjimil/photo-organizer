# Copy to opal.env (not committed)

# Python executable (desktop / scripts)
OPAL_PYTHON=python

# Library paths
# IMAGE_FOLDER=/path/to/photos
# MANIFEST_PATH=./data/manifest.db
# CHROMA_PATH=./my_quote_library

# Compute: cuda | mps | cpu (auto-detect if unset)
# DEVICE=mps

# Models
# CLIP_MODEL=google/siglip2-base-patch16-256
# OCR_ENGINE=rapidocr
# OCR needs onnxruntime-gpu==1.20.x (CUDA 12). Do not install CPU-only onnxruntime.
# Newer ort-gpu (1.29+) wants CUDA 13 and will silently fall back to CPU.

# CLIP batch size (default: 16 CUDA, 8 MPS, 4 CPU)
# CLIP_BATCH_SIZE=16

# Auto-index when files change under source folders (default on)
# FOLDER_WATCH=1
# FOLDER_WATCH_DEBOUNCE_SEC=2.5

# macOS: set automatically by Tauri; optional for manual API runs
# PYTORCH_ENABLE_MPS_FALLBACK=1
